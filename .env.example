# 科研助手 Agent 运行配置示例
# 用法：复制为 .env 并填入实际值后启动（uvicorn app.main:app --reload）

# ===== LLM（推理大脑，OpenAI 兼容协议）=====
LLM__PROVIDER=openai
LLM__BASE_URL=https://api.openai.com/v1
LLM__API_KEY=sk-your-key-here
LLM__MODEL=gpt-4o-mini

# ===== 嵌入模型（本地知识库 RAG 检索）=====
# 默认（本地 sentence-transformers 语义嵌入，首次使用自动下载权重）：
# KNOWLEDGE__EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
#
# 切换到本地 Ollama 生成的嵌入（需先安装并运行 Ollama，再拉取模型）：
#   ollama serve
#   ollama pull nomic-embed-text
# 然后启用下行（去掉注释即可）：
KNOWLEDGE__EMBEDDING_MODEL=ollama://nomic-embed-text
# 若 Ollama 不在默认 11434 端口，可显式指定 host：
# KNOWLEDGE__EMBEDDING_MODEL=ollama://127.0.0.1:11434/nomic-embed-text

# 若要把 Ollama 模型文件也存到 D 盘（而非默认用户目录），可设：
# OLLAMA_MODELS=D:/ollama/models

# KNOWLEDGE__VECTOR_TOP_K=5
# KNOWLEDGE__RERANK_TOP_K=3
# 可选二阶段语义精排：首次使用会下载模型，失败自动降级 lexical。
# KNOWLEDGE__RERANKER_KIND=cross-encoder
# KNOWLEDGE__RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ===== 服务 =====
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# 本地 Agent Skills（扫描 <directory>/*/SKILL.md；启停状态写入 JSON）
SKILLS__DIRECTORY=./skills
SKILLS__STATE_PATH=./data/skills_state.json

# MCP stdio 服务（Windows 上通过 cmd /c 启动 npx）
# 文件系统务必只授权必要目录，不要授权整个磁盘或用户主目录。
MCP_SERVERS='[{"name":"filesystem","command":"cmd","args":["/c","npx","-y","@modelcontextprotocol/server-filesystem","D:/科研助手agent/data"]},{"name":"zotero","command":"D:/科研助手agent/var/mcp/zotero/Scripts/zotero-mcp.exe","args":["serve","--transport","stdio"],"env":{"ZOTERO_LOCAL":"true"}}]'
